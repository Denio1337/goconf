# Layer 1: Base configuration (.env)
APP_NAME=BaseApp
ENVIRONMENT=development
DEBUG=true
FEATURES=logging,metrics

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_TIMEOUT=5s
SERVER_MAX_CONNS=100

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=env_secret_password
DATABASE_NAME=default_app_db
